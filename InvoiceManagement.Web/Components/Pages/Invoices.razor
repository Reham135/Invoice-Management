@page "/invoices"
@rendermode InteractiveServer

@using InvoiceManagement.Application.DTOs
@using InvoiceManagement.Application.Interfaces
@using InvoiceManagement.Domain.Enums

@inject IInvoiceService InvoiceService

<PageTitle>Invoices</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Invoices</h1>

        <p class="text-muted mb-0">
            Manage invoices and their line items.
        </p>
    </div>

    <a href="/invoices/create"
       class="btn btn-primary">
        + New Invoice
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(deleteError))
{
    <div class="alert alert-warning alert-dismissible fade show mb-4"
         role="alert">

        @deleteError

        <button type="button"
                class="btn-close"
                aria-label="Close"
                @onclick="ClearDeleteError">
        </button>

    </div>
}

@if (invoiceToDelete != null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4">

        <div>
            <strong>
                Delete invoice @invoiceToDelete.InvoiceNumber?
            </strong>

            <div>
                This action cannot be undone.
            </div>
        </div>

        <div>
            <button type="button"
                    class="btn btn-danger"
                    disabled="@isDeleting"
                    @onclick="DeleteAsync">

                @if (isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          aria-hidden="true">
                    </span>

                    <span>Deleting...</span>
                }
                else
                {
                    <span>Yes, Delete</span>
                }

            </button>

            <button type="button"
                    class="btn btn-secondary ms-2"
                    disabled="@isDeleting"
                    @onclick="CancelDelete">
                Cancel
            </button>
        </div>

    </div>
}

@if (invoices == null)
{
    <div class="text-center py-5">

        <div class="spinner-border text-primary"
             role="status">
        </div>

        <p class="text-muted mt-3">
            Loading invoices...
        </p>

    </div>
}
else if (invoices.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">

            <h4>
                No invoices yet
            </h4>

            <p class="text-muted">
                Create your first invoice to get started.
            </p>

            <a href="/invoices/create"
               class="btn btn-primary">
                Create Invoice
            </a>

        </div>
    </div>
}
else
{
    <div class="card">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>
                            Invoice #
                        </th>

                        <th>
                            Customer
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end">
                            Total
                        </th>

                        <th class="text-end">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var invoice in invoices)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @invoice.InvoiceNumber
                            </td>

                            <td>
                                @invoice.CustomerName
                            </td>

                            <td>
                                @invoice.InvoiceDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <span class="@GetStatusClass(invoice.Status)">
                                    @invoice.Status
                                </span>
                            </td>

                            <td class="text-end fw-semibold">
                                @invoice.Total.ToString("N2")
                            </td>

                            <td class="text-end">

                                <a href="/invoices/@invoice.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <a href="/invoices/@invoice.Id/edit"
                                   class="btn btn-sm btn-outline-secondary ms-1">
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger ms-1"
                                        disabled="@isDeleting"
                                        @onclick="() => ShowDeleteConfirmation(invoice)">
                                    Delete
                                </button>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

@code {
    private List<InvoiceDto>? invoices;

    private InvoiceDto? invoiceToDelete;

    private string? deleteError;

    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        invoices =
            await InvoiceService.GetAllAsync();
    }

    private void ShowDeleteConfirmation(
        InvoiceDto invoice)
    {
        if (isDeleting)
            return;

        deleteError = null;
        invoiceToDelete = invoice;
    }

    private void CancelDelete()
    {
        if (isDeleting)
            return;

        invoiceToDelete = null;
        deleteError = null;
    }

    private void ClearDeleteError()
    {
        deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (invoiceToDelete == null || isDeleting)
            return;

        deleteError = null;
        isDeleting = true;

        try
        {
            var invoiceId =
                invoiceToDelete.Id;

            var deleted =
                await InvoiceService.DeleteAsync(invoiceId);

            if (deleted)
            {
                invoices?.RemoveAll(x =>
                    x.Id == invoiceId);

                invoiceToDelete = null;

                return;
            }

            deleteError =
                "The invoice could not be deleted because it no longer exists.";

            invoiceToDelete = null;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string GetStatusClass(
        InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Draft =>
                "badge text-bg-secondary",

            InvoiceStatus.Issued =>
                "badge text-bg-primary",

            InvoiceStatus.Paid =>
                "badge text-bg-success",

            InvoiceStatus.Cancelled =>
                "badge text-bg-danger",

            _ =>
                "badge text-bg-secondary"
        };
    }
}