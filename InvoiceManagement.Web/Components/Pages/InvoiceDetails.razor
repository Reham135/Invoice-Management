@page "/invoices/{Id:int}"
@rendermode InteractiveServer

@using InvoiceManagement.Application.DTOs
@using InvoiceManagement.Application.Interfaces

@inject IInvoiceService InvoiceService
@inject NavigationManager Navigation

<PageTitle>Invoice Details</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"
             role="status">
        </div>

        <p class="text-muted mt-3">
            Loading invoice...
        </p>
    </div>
}
else if (invoice == null)
{
    <div class="alert alert-warning">
        Invoice not found.
    </div>

    <a href="/invoices"
       class="btn btn-secondary">
        Back to Invoices
    </a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                @invoice.InvoiceNumber
            </h1>

            <span class="text-muted">
                Invoice Details
            </span>
        </div>

        <div>
            <a href="/invoices/@invoice.Id/edit"
               class="btn btn-outline-primary">
                Edit
            </a>

            <button type="button"
                    class="btn btn-outline-danger ms-2"
                    disabled="@isDeleting"
                    @onclick="ShowDeleteConfirmation">
                Delete
            </button>

            <a href="/invoices"
               class="btn btn-secondary ms-2">
                Back
            </a>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(deleteError))
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4"
             role="alert">

            @deleteError

            <button type="button"
                    class="btn-close"
                    aria-label="Close"
                    @onclick="ClearDeleteError">
            </button>

        </div>
    }

    @if (showDeleteConfirmation)
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4">

            <div>
                <strong>
                    Delete this invoice?
                </strong>

                <div>
                    This action cannot be undone.
                </div>
            </div>

            <div>
                <button type="button"
                        class="btn btn-danger"
                        disabled="@isDeleting"
                        @onclick="DeleteAsync">

                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              aria-hidden="true">
                        </span>

                        <span>
                            Deleting...
                        </span>
                    }
                    else
                    {
                        <span>
                            Yes, Delete
                        </span>
                    }

                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        disabled="@isDeleting"
                        @onclick="CancelDelete">
                    Cancel
                </button>
            </div>

        </div>
    }

    <div class="card mb-4">
        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <small class="text-muted">
                        Customer
                    </small>

                    <div class="fw-semibold">
                        @invoice.CustomerName
                    </div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">
                        Invoice Date
                    </small>

                    <div class="fw-semibold">
                        @invoice.InvoiceDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">
                        Status
                    </small>

                    <div class="fw-semibold">
                        @invoice.Status
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h4 class="mb-1">
                Line Items
            </h4>

            <small class="text-muted">
                Products and services included in this invoice.
            </small>
        </div>

    </div>

    <div class="card">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>
                            Description
                        </th>

                        <th class="text-end">
                            Quantity
                        </th>

                        <th class="text-end">
                            Unit Price
                        </th>

                        <th class="text-end">
                            Line Total
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in invoice.LineItems)
                    {
                        <tr>
                            <td>
                                @item.Description
                            </td>

                            <td class="text-end">
                                @item.Quantity.ToString("N2")
                            </td>

                            <td class="text-end">
                                @item.UnitPrice.ToString("N2")
                            </td>

                            <td class="text-end fw-semibold">
                                @item.LineTotal.ToString("N2")
                            </td>
                        </tr>
                    }

                </tbody>

                <tfoot class="table-light">
                    <tr>
                        <td colspan="3"
                            class="text-end fw-bold">
                            Invoice Total
                        </td>

                        <td class="text-end fw-bold">
                            @invoice.Total.ToString("N2")
                        </td>
                    </tr>
                </tfoot>

            </table>

        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDto? invoice;

    private string? deleteError;

    private bool isLoading = true;

    private bool showDeleteConfirmation;

    private bool isDeleting;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        showDeleteConfirmation = false;
        deleteError = null;

        invoice =
            await InvoiceService.GetByIdAsync(Id);

        isLoading = false;
    }

    private void ShowDeleteConfirmation()
    {
        if (isDeleting)
            return;

        deleteError = null;
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        if (isDeleting)
            return;

        showDeleteConfirmation = false;
        deleteError = null;
    }

    private void ClearDeleteError()
    {
        deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (invoice == null || isDeleting)
            return;

        deleteError = null;
        isDeleting = true;

        try
        {
            var deleted =
                await InvoiceService.DeleteAsync(invoice.Id);

            if (deleted)
            {
                Navigation.NavigateTo("/invoices");
                return;
            }

            deleteError =
                "The invoice could not be deleted because it no longer exists.";

            showDeleteConfirmation = false;
        }
        finally
        {
            isDeleting = false;
        }
    }
}